# SERVER & NETWORK
MCP_SERVER_PORT=5001
MCP_TRANSPORT=sse                        # 'sse' or 'http' for remote per-request headers

# SECURITY & ENCRYPTION
MCP_AUTH_SECRET=super_secret_mcp_token   # Authenticates Orchestrator -> MCP Server
ENCRYPTION_KEY=a_32_byte_secret_key_for_db_keys # Decrypts stored user API keys

# DATABASE (For retrieving user/org key configurations)
DB_URL="postgresql://postgres:postgres@localhost:5432/gitsentinel_db?schema=public"