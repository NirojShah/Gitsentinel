model Chat {
    id        String   @id @default(uuid())
    chatName  String?
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    repoId    String
    gitRepo   GitRepo  @relation(fields: [repoId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([id, userId, repoId])
    @@map("chat")
}
