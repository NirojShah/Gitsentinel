model GitRepo {
  id          String      @id @default(uuid())
  provider    GitProvider
  repoUrl     String
  accessToken String
  baseBranch  String      @default("main")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  @@map("gitrepo")
}

enum GitProvider {
  GITHUB
  GITLAB
  BITBUCKET
}
